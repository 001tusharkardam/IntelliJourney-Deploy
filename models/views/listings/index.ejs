<% layout("/layouts/boilerplate") %>

  <style>
    #filters {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      overflow-x: auto;
      padding: 0.5rem 0; /* less padding */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #filters::-webkit-scrollbar {
      display: none;
    }

    .filter {
      text-align: center;
      margin-right: 1.5rem; /* smaller gap */
      opacity: 0.6;
      color: black;
      flex-shrink: 0;
      min-width: 50px;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }
    
    .filter i {
      font-size: 1.25rem; /* slightly larger icon */
      margin-bottom: 0.2rem;
    }

    .filter p {
      font-size: 0.75rem; /* thinner text */
      margin-top: 0.2rem;
      font-weight: 500;
      color: inherit;
    }

    .filter.active {
      opacity: 1;
      border-bottom: 2px solid #222;
    }
    .filter.active p {
      color: #222;
      font-weight: 600;
      margin-bottom: -2px; /* compensate for border */
    }

    .tax-info {
      display: none;
    }

    .tag-toggle {
      border: 1px solid #ddd;
      border-radius: 12px;
      height: 3rem;
      padding: 0 1rem;
      display: flex;
      align-items: center;
      background: white;
    }
    
    .form-switch .form-check-input {
      cursor: pointer;
      width: 2.5em; /* standard switch size */
      background-color: #b0b0b0;
      border: none;
    }
    .form-switch .form-check-input:checked {
      background-color: #222; /* Black active switch like Airbnb */
    }

    /* Mobile adjustments */
    @media (max-width: 768px) {
      .filters-container {
        flex-direction: column;
        align-items: stretch !important;
        margin-top: 0 !important;
      }
      #filters {
        padding-bottom: 0.5rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid #ebebeb;
      }
      .tag-toggle {
        margin: 0.5rem 1rem;
        width: auto;
        border: none;
        justify-content: space-between;
        padding: 0;
        height: auto;
      }
    }
  </style>

  <div class="filters-container d-flex flex-nowrap align-items-center justify-content-between mb-3 mt-3">
    <div id="filters" class="flex-grow-1">
      <a href="/listings" class="filter <%= selectedCategory === undefined || selectedCategory === '' ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </a>
      <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
      </a>
      <a href="/listings?category=Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </a>
      <a href="/listings?category=Amazing pools" class="filter <%= selectedCategory === 'Amazing pools' ? 'active' : '' %>">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing pools</p>
      </a>
      <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active' : '' %>">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </a>
      <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </a>
      <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tractor"></i></div>
        <p>Farms</p>
      </a>
      <a href="/listings?category=Arctic" class="filter <%= selectedCategory === 'Arctic' ? 'active' : '' %>">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
      </a>
      <a href="/listings?category=Domes" class="filter <%= selectedCategory === 'Domes' ? 'active' : '' %>">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
      </a>
      <a href="/listings?category=Boats" class="filter <%= selectedCategory === 'Boats' ? 'active' : '' %>">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
      </a>
    </div>

    <!-- Toggle outside the scrollable area -->
    <div class="tag-toggle">
      <div class="form-check-reverse form-switch w-100 d-flex justify-content-between align-items-center m-0">
        <input type="checkbox" class="form-check-input ms-3 m-0" role="switch" id="flexSwitchCheckDefault">
        <label class="form-check-label ms-2 m-0" for="flexSwitchCheckDefault" style="font-size: 0.95rem; font-weight: 500; color: var(--bs-body-color);">Display total before taxes</label>
      </div>
    </div>
  </div>

  <div class="row row-cols-xl-5 row-cols-lg-4 row-cols-md-4 row-cols-sm-3 row-cols-3 mt-3 g-2 g-md-3" id="listings-grid">
    <% if(allListings.length===0) { %>
      <div class="col-12 text-center">
        <div style="padding: 3rem 1rem;">
          <i class="fa-solid fa-cloud-moon" style="font-size: 3rem; color: #ddd; margin-bottom: 1rem;"></i>
          <p style="font-size: 1.25rem; color: #555; font-weight: 500;">
            <% if(search) { %>
              No results found for "<%= search %>"
                <% } else if(selectedCategory) { %>
                  No listings found in "<%= selectedCategory %>"
                    <% } else { %>
                      No listings available at the moment.
                      <% } %>
          </p>
          <p style="color: #888;">Try adjusting your search or filters to find what you're looking for.</p>
          <a href="/listings" class="btn btn-outline-dark mt-2">Clear all filters</a>
        </div>
      </div>
      <% } %>
        <% for(let listing of allListings) { %>
          <a href="/listings/<%= listing._id %>" class="listing-links">
            <div class="card col listing-card">
             <% if(listing.images && listing.images.length > 0) { %>
                <div id="carousel-<%= listing._id %>" class="carousel slide" data-bs-ride="false" data-bs-interval="false">
                  <div class="carousel-indicators">
                    <% listing.images.forEach((img, i) => { %>
                      <button type="button" data-bs-target="#carousel-<%= listing._id %>" data-bs-slide-to="<%= i %>" class="<%= i === 0 ? 'active' : '' %>" aria-current="true" aria-label="Slide <%= i+1 %>" onclick="event.preventDefault(); event.stopPropagation();"></button>
                    <% }) %>
                  </div>
                  <div class="carousel-inner" style="border-radius: 1rem; background: #fff;">
                    <% listing.images.forEach((img, i) => { %>
                      <div class="carousel-item <%= i === 0 ? 'active' : '' %>" style="background: #fff; text-align: center;">
                        <img src="<%= img.url.replace('/upload', '/upload/w_400,q_auto,f_auto') %>" class="d-block w-100 card-img-top" alt="listing image" style="object-fit:cover;">
                      </div>
                    <% }) %>
                  </div>
                  <% if(listing.images.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carousel-<%= listing._id %>" data-bs-slide="prev" onclick="event.preventDefault(); event.stopPropagation();">
                      <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: drop-shadow(0px 0px 4px rgba(0,0,0,0.5));"></span>
                      <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carousel-<%= listing._id %>" data-bs-slide="next" onclick="event.preventDefault(); event.stopPropagation();">
                      <span class="carousel-control-next-icon" aria-hidden="true" style="filter: drop-shadow(0px 0px 4px rgba(0,0,0,0.5));"></span>
                      <span class="visually-hidden">Next</span>
                    </button>
                  <% } %>
                </div>
             <% } else { %>
                <img 
                  src="<%= listing.image ? (typeof listing.image === 'object' ? listing.image.url : listing.image).replace('/upload', '/upload/w_400,q_auto,f_auto') : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60' %>" 
                  loading="lazy"
                  class="card-img-top"
                  alt="listing image"
                  style="object-fit:cover;"
                />
             <% } %>
              <div class="card-img-overlay"></div>
              <div class="card-body" style="padding: 0.5rem 0.25rem;">
                <p class="card-text mb-0" style="line-height: 1.3;">
                  <span class="text-truncate d-inline-block w-100" style="font-weight: 600; font-size: 0.95rem; color: var(--bs-body-color);"><%= listing.title %></span><br>
                  <span style="font-size: 0.85rem; color: var(--bs-secondary-color);" class="text-body-secondary">Added recently</span><br>
                  <span style="font-weight: 600; margin-top: 0.15rem; display: inline-block; font-size: 0.95rem; color: var(--bs-body-color);">
                    &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %>
                  </span> 
                  <span style="font-size: 0.9rem; color: var(--bs-body-color);">night</span>
                  <i class="tax-info" style="font-weight:400; font-size:0.85rem; color: var(--bs-secondary-color);">&nbsp; &nbsp; +18% GST</i>
                </p>
              </div>
            </div>
          </a>
          <% } %>
  </div>

  <script>
    let taxSwitch = document.getElementById('flexSwitchCheckDefault');
    if (taxSwitch) {
      taxSwitch.addEventListener("click", () => {
        let taxInfo = document.querySelectorAll('.tax-info');
        for (let info of taxInfo) {
          if (info.style.display != "inline") {
            info.style.display = "inline";
          } else {
            info.style.display = "none";
          }
        }
      });
    }
  </script>
